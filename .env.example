# NAS 上用于本应用的专用数据目录。可以是本机挂载好的 NAS 路径。
NAS_DATA_PATH=./data
# 数据库、账号和权限信息放在应用服务器本地的持久化磁盘上。
# 请勿将 SQLite WAL 数据库目录放在 SMB/NFS 网络共享上。
LOCAL_STATE_PATH=./state
# 本机试用默认仅回环地址；局域网试点可改成服务器的局域网 IP。
DRIVE_BIND=127.0.0.1
DRIVE_MAX_FILE_GB=100
# 对外 HTTPS 部署后设为 1；仅本地 HTTP 试用保留 0。
DRIVE_SECURE_COOKIE=0
# 只有服务放在可信反向代理后且直连端口不可从公网访问时，才设为 1。
DRIVE_TRUST_PROXY=0

# Optional ONLYOFFICE Docs integration. Leave all values blank to disable.
OFFICE_PUBLIC_URL=
OFFICE_DRIVE_URL=
OFFICE_RESULT_URL=
OFFICE_JWT_SECRET=
OFFICE_JWT_HEADER=Authorization
